{
  "name": "eg/eg-backup",
  "description": "Sauvegarde et restauration intelligente de WordPress",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12 || ^2.0",
    "php-stubs/wordpress-stubs": "^6.7",
    "php-stubs/wp-cli-stubs": "^2.11",
    "squizlabs/php_codesniffer": "^3.11",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "EGBackup\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EGBackup\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse --no-progress",
    "phpcs": "phpcs -q",
    "test": "phpunit --no-coverage"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
